{
  "name": "effect-manager-benchmark",
  "scope": "Synthetic manager-only benchmark, frozen server, inert Effect callbacks in isolated fixture pack, armor stands, 1/5/10/20 Effects and 1/20 owners. One warmup and three profiled batches of 1000 owner-ticks per case. Batch is scheduled after a profiler activation tick. Exact completed batches and remaining durations are asserted. debug elapsed time includes profiling, background core ticks and RCON scheduling overhead; not gameplay MSPT. Compare same scenario on HEAD and working tree.",
  "players": [],
  "steps": [
    {
      "name": "benchmark_limits",
      "commands": [
        "gamerule maxCommandChainLength 10000000",
        "gamerule maxCommandChainLength"
      ],
      "expect": [
        "10000000"
      ]
    },
    {
      "name": "setup_M1_N1",
      "commands": [
        "function effect_test:benchmark/setup.m {Owners:1,Effects:1}",
        "function effect_test:benchmark/batch.m {Iterations:1000}",
        "data get storage effect_test: Completed"
      ],
      "expect": [
        "following contents: 1000"
      ]
    },
    {
      "name": "profile_start_M1_N1_1",
      "commands": [
        "debug start"
      ],
      "expect": [
        "Started tick profiling"
      ]
    },
    {
      "name": "profile_activate_M1_N1_1",
      "ticks": 1
    },
    {
      "name": "schedule_M1_N1_1",
      "commands": [
        "data modify storage effect_test: BenchArgs set value {Iterations:1000}",
        "data modify storage effect_test: Completed set value 0",
        "schedule function effect_test:benchmark/scheduled 1t",
        "data get storage effect_test: Completed"
      ],
      "expect": [
        "following contents: 0"
      ]
    },
    {
      "name": "profile_batch_M1_N1_1",
      "ticks": 1
    },
    {
      "name": "measure_M1_N1_1",
      "commands": [
        "debug stop",
        "data get storage effect_test: Completed",
        "execute as @e[tag=EffectTest.Bench,limit=1] run function oh_my_dat:please",
        "data get storage oh_my_dat: _[-4][-4][-4][-4][-4][-4][-4][-4].Effects[0].Duration"
      ],
      "expect": [
        "Stopped.*profiling",
        "following contents: 1000",
        "following contents: 999998000"
      ]
    },
