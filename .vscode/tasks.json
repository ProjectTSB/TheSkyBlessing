{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Open SkyBlock Server",
            "type": "process",
            "command": "sh",
            "args": ["${workspaceFolder}/.vscode/server-start.sh"],
            "options": {"cwd": "${workspaceFolder}"},
            "windows": {"command": "${env:ProgramFiles}/Git/bin/bash.exe"},
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            },
            "promptOnClose": true,
            "problemMatcher": []
        }
    ]
}
